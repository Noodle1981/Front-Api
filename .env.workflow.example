# Workflow Python API Configuration
# Endpoint genérico (workflows no-conciliación)
WORKFLOW_PYTHON_API_URL=http://localhost:8000/procesar
# Endpoint para workflow "Conciliación" (JSON response)
WORKFLOW_PYTHON_API_CONCILIAR_URL=http://localhost:8000/conciliar
# Endpoint para workflow "Conciliación y Arqueo" (JSON response - formato arqueo)
WORKFLOW_PYTHON_API_PROCESAR_JSON_URL=http://localhost:8000/procesar-json
WORKFLOW_PYTHON_API_TIMEOUT=120
# true = usar datos mock locales, false = llamar API externa real
WORKFLOW_PYTHON_API_MOCK=true
